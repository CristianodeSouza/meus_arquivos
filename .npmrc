; NPM Configuration to handle connection issues
; Increase timeouts for npm registry requests
fetch-timeout=60000
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-retries=5

; Use a more stable npm registry
registry=https://registry.npmjs.org/

; Disable SSL verification only if necessary (use with caution)
; strict-ssl=false

; Additional network settings
connection-timeout=60000
